projection;
strict ( 2 );
use draft;

define behavior for /EACM/C_AGENT alias Agent
{
  use create;
  use update;
  use delete;

  use action Edit;
  use action Activate;
  use action Discard;
  use action Resume;
  use action Prepare;

  use action Suspend;
  use action Reactivate;
  use action Deactivate;

  use association _Shareholder { create; with draft; }
}

define behavior for /EACM/C_AGT_SHAREHOLD alias Shareholder
{
  use update;
  use delete;

  use association _Agent { with draft; }
}